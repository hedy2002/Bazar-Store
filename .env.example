# Supabase Dashboard > Project Settings > Database
# Use the transaction pooler URL (port 6543) for DATABASE_URL on Vercel.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Use a direct database URL or the session pooler URL (port 5432) for migrations.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
# Server-only Supabase service role key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
PRODUCT_IMAGES_BUCKET="products"

# Comma-separated Supabase Auth email addresses assigned the STORE_OWNER role.
ADMIN_EMAILS="Headi.karim@gmail.com"
